@page "/"
@inject IJSRuntime JS

<PageTitle>Rushi</PageTitle>

<main class="portfolio-page">
    <section id="about" class="section portfolio-hero">
        <div class="hero-avatar">
            <img src="./images/my_image.jpg" alt="My Photo" class="img-fluid rounded-circle">
        </div>
        <div class="hero-copy">
            <h1>Rushikesh Sane</h1>
            <p>
                Full stack developer focused on backend architecture, reliable systems, and practical engineering.
            </p>
            <div class="hero-actions">
                <a class="primary-btn" href="#projects">View work</a>
                <a class="secondary-btn" href="/contact">Contact me</a>
            </div>
        </div>
    </section>

    <section class="section portfolio-panel">
        <div class="section-header">
            <h2>Who am I?</h2>
            <p class="section-subtitle">
                A blend of cultures, curiosity, and code.
            </p>
        </div>
        <p>
            Originally from Pune, India, I have been working in the software industry since 2017. Having lived in multiple countries and collaborated with teams across the globe, I'm always up for friendly conversations about technology, weather, the meaning of life, or any random shower tought.
        </p>
        <p>
            I have a passion for learning and sharing my knowledge, experience, and shower thoughts with others. If you're interested in learning more about me, feel free to explore the rest of my website.
        </p>
    </section>

    <Technologies />

    <section class="section portfolio-panel">
        <div class="section-header">
            <h2>My personality type</h2>
        </div>
        <div class="hero-actions">
            <button class="primary-btn" onclick="window.open('https://www.16personalities.com/entj-personality', '_blank')">
                The Commander
            </button>
            <button class="secondary-btn" @onclick="ScrollToTimeline">View Timeline</button>
        </div>
    </section>

    <section id="projects" class="section portfolio-panel">
        <div class="section-header">
            <h2>Featured Writing</h2>
            <p class="section-subtitle">A sample of technical and personal posts.</p>
        </div>
        <div class="grid">
            <div class="card">
                <h3><a href="/blogs/random/panchang">Almanac / Panchang</a></h3>
                <p>Want to be able to write and calculate your own almanac (or panchang)?</p>
            </div>
            <div class="card">
                <h3><a href="/blogs/travel/chennai">Trip to Chennai</a></h3>
                <p>Travelogue on a Chennai trip in 2024.</p>
            </div>
            <div class="card">
                <h3><a href="/blogs/technology/ai/agents-md-governing-ai-dotnet">Governing AI in Codebases</a></h3>
                <p>How to use agents.md to keep AI-assisted coding safe and consistent.</p>
            </div>
            <div class="card">
                <h3><a href="/blogs/technology/designpatterns/adapter-pattern-clean-architecture-guide">Adapter Pattern Guide</a></h3>
                <p>Clean Architecture focused guide to implementing adapters in production systems.</p>
            </div>
        </div>
    </section>

    <section id="resume" class="section portfolio-panel">
        <div class="section-header">
            <h2>My life in a nutshell</h2>
            <p class="section-subtitle">Key milestones along the way.</p>
        </div>
        <div class="timeline-shell">
            <div class="timeline-section">
                <div class="timeline-wrapper">
                    <div class="timeline">
                        <div class="timeline-item">
                            <div class="timeline-year">1995</div>
                            <div class="timeline-dot"></div>
                            <div class="timeline-description">
                                Born in Pune.
                            </div>
                        </div>
                        <div class="timeline-item">
                            <div class="timeline-year">2013</div>
                            <div class="timeline-dot"></div>
                            <div class="timeline-description">
                                Graduated high school.
                            </div>
                        </div>
                        <div class="timeline-item">
                            <div class="timeline-year">2017</div>
                            <div class="timeline-dot"></div>
                            <div class="timeline-description">
                                Graduated with bachelor's degree. Started my 1st job with Bentley Systems in Pune.
                            </div>
                        </div>
                        <div class="timeline-item">
                            <div class="timeline-year">2018</div>
                            <div class="timeline-dot"></div>
                            <div class="timeline-description">
                                Embarked on global adventures. Left home to pursue a master's degree in Finland.
                            </div>
                        </div>
                        <div class="timeline-item">
                            <div class="timeline-year">2019</div>
                            <div class="timeline-dot"></div>
                            <div class="timeline-description">
                                Moved to Norway to work with Vimond.
                            </div>
                        </div>
                        <div class="timeline-item">
                            <div class="timeline-year">2020</div>
                            <div class="timeline-dot"></div>
                            <div class="timeline-description">
                                Finished master's degree while working full time.
                            </div>
                        </div>
                        <div class="timeline-item">
                            <div class="timeline-year">2021</div>
                            <div class="timeline-dot"></div>
                            <div class="timeline-description">
                                Joined StormGeo.
                            </div>
                        </div>
                        <div class="timeline-item">
                            <div class="timeline-year">2022</div>
                            <div class="timeline-dot"></div>
                            <div class="timeline-description">
                                Started learning Norwegian.
                            </div>
                        </div>
                        <div class="timeline-item">
                            <div class="timeline-year">2024</div>
                            <div class="timeline-dot"></div>
                            <div class="timeline-description">
                                Planning future endeavors and dreaming big for what comes next.
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>

@code {
    private async Task ScrollToTimeline()
    {
        await JS.InvokeVoidAsync("scrollToElementById", "resume");
    }
}
