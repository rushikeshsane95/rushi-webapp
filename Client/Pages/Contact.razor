@page "/contact"

<PageTitle>Contact</PageTitle>

<section class="contact-page">
    <div class="contact-shell">
        <div class="contact-header">
            <h1>Let's Connect</h1>
            <p>
                Have a question, an opportunity, or a collaboration idea? Send me a message and I'll get back to you.
            </p>
        </div>

        <form class="contact-card contact-form" action="https://formspree.io/f/xregledn" method="POST">
            <div class="field-row">
                <label for="name">Name</label>
                <input id="name" type="text" name="name" autocomplete="name" placeholder="Your full name" required />
            </div>

            <div class="field-row">
                <label for="email">Email</label>
                <input id="email" type="email" name="email" autocomplete="email" placeholder="you@example.com" required />
            </div>

            <div class="field-row">
                <label for="message">Message</label>
                <textarea id="message" name="message" rows="7" placeholder="Tell me a bit about what you need..." required></textarea>
            </div>

            <label class="honeypot" for="website">
                Leave this empty:
                <input id="website" type="text" name="website" tabindex="-1" autocomplete="off" />
            </label>

            <div class="form-actions">
                <button type="submit">Send Message</button>
            </div>
            <span class="form-note">I usually respond within 1-2 business days.</span>
        </form>
    </div>
</section>
