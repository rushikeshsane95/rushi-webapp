@page "/blogs/technology/n-plus-one-problem"

@inject HttpClient Http

<div class="blog-container">
    @if (string.IsNullOrWhiteSpace(htmlContent))
    {
        <p>Loading blog post...</p>
    }
    else
    {
        @((MarkupString)htmlContent)
    }

    <p>
        <a href="/blogs/technology">Back to Technology Blogs</a>
    </p>
</div>

@code {
    private string htmlContent = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var markdown = await Http.GetStringAsync("blogs/technology/n-plus-one-problem.md");
        htmlContent = Markdig.Markdown.ToHtml(markdown);
    }
}
